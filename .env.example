# ==========================================
# BACKEND (Render) Environment Variables
# ==========================================
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
ADMIN_PIN=1234

# ==========================================
# FRONTEND (Vercel) Environment Variables
# ==========================================
# Must start with VITE_ to be bundled by Vite
VITE_API_URL=https://<your-backend-app-name>.onrender.com